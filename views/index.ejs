<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AI Workspace</title>

    <link rel="stylesheet" href="/CSS/style.css" />
    <link rel="stylesheet" href="/CSS/auth.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css"
    />

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>

  </head>

  <body>
    <%- include('partials/sidebar') %>

    <main class="main-content">
      <header class="topbar">
        <button class="menu-toggle" id="menuToggle">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <h3 id="pageTitle">Dashboard</h3>

        <div class="topbar-right">✦ AI Workspace</div>
      </header>

      <div class="content" id="mainContent">
        <!-- Dashboard / Folder / Question UI generated by JS -->
      </div>

      <!-- AUTH OVERLAY -->
      <div class="auth-overlay" id="authOverlay"></div>

      <!-- LOGIN AND REGISTER PANEL -->
      <div class="LoginForm" id="LoginAndRegister">
        <div class="auth-container">
          <!-- Header -->
          <div class="auth-header">
            <div>
              <span class="auth-logo">✦</span>
              <span class="auth-brand">AI Workspace</span>
            </div>

            <button type="button" id="closeAuth" class="close-auth">
              &times;
            </button>
          </div>

          <!-- Auth Content -->
          <div class="auth-body">
            <div class="auth-heading" id="authHeading">
              <h1 id="authTitle">Welcome Back!</h1>
              <p id="authSubtitle">Login to continue to your workspace.</p>
            </div>

            <!-- Tabs -->
            <div class="auth-tabs" id="ProfileAccessModeOn">
              <button type="button" id="loginTab" class="auth-tab active">
                Login
              </button>

              <button type="button" id="registerTab" class="auth-tab">
                Register
              </button>
            </div>

            <!-- LOGIN FORM -->
            <form id="loginForm">
              <div class="auth-input-group">
                <label>Email Address</label>
                <input
                  type="email"
                  id="loginEmail"
                  placeholder="Enter your email"
                  required
                />
              </div>

              <div class="auth-input-group">
                <label>Password</label>

                <div class="password-box">
                  <input
                    type="password"
                    id="loginPassword"
                    placeholder="Enter your password"
                    required
                  />

                  <button
                    type="button"
                    class="password-toggle"
                    data-target="loginPassword"
                  >
                    Show
                  </button>
                </div>
              </div>

              <p id="loginMessage" class="auth-message"></p>

              <button type="submit" class="auth-submit" id="loginSubmit">
                Login to Workspace <span>→</span>
              </button>
            </form>

            <!-- REGISTER FORM -->
            <form id="registerForm" hidden>
              <div class="auth-input-group">
                <label>Full Name</label>
                <input
                  type="text"
                  id="registerName"
                  placeholder="Enter your full name"
                  required
                />
              </div>

              <div class="auth-input-group">
                <label>Email Address</label>
                <input
                  type="email"
                  id="registerEmail"
                  placeholder="Enter your email"
                  required
                />
              </div>

              <div class="auth-input-group">
                <label>Password</label>

                <div class="password-box">
                  <input
                    type="password"
                    id="registerPassword"
                    placeholder="Create a password"
                    minlength="6"
                    required
                  />

                  <button
                    type="button"
                    class="password-toggle"
                    data-target="registerPassword"
                  >
                    Show
                  </button>
                </div>
              </div>

              <p id="registerMessage" class="auth-message"></p>

              <button type="submit" class="auth-submit" id="registerSubmit">
                Create Account <span>→</span>
              </button>
            </form>

            <!-- PROFILE OVERLAY -->
            <div class="profile-overlay" id="profileOverlay"></div>

            <!-- PROFILE PANEL -->
            <div class="auth-profile" id="AuthProfile">
              <div class="profile-content">
                <div class="profile-avatar" id="profileAvatar">M</div>

                <h3 id="profileName">My Account</h3>
                <p id="profileEmail">user@example.com</p>

                <div class="profile-details">
                  <div class="profile-detail-item">
                    <span>Full Name</span>
                    <strong id="detailName">My Account</strong>
                  </div>

                  <div class="profile-detail-item">
                    <span>Email Address</span>
                    <strong id="detailEmail">user@example.com</strong>
                  </div>

                  <div class="profile-detail-item">
                    <span>Account Status</span>
                    <strong class="account-status">Logged In</strong>
                  </div>
                </div>

                <p id="logoutMessage" class="profile-message"></p>

                <button type="button" class="logout-btn" id="logoutBtn">
                  <span>↪</span> Logout
                </button>
              </div>
            </div>

            <div class="auth-footer">
              <p>Secure authentication · AI Workspace</p>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Folder Modal -->

    <div class="modal" id="folderModal">
      <div class="modal-box">
        <div class="modal-header">
          <h2>Create Folder</h2>
          <button class="modal-close" data-close="folderModal">×</button>
        </div>

        <p>Organize your questions by creating a folder.</p>

        <input type="text" id="folderName" placeholder="Enter folder name..." />

        <div class="modal-actions">
          <button class="cancel-btn" data-close="folderModal">Cancel</button>

          <button class="primary-btn" id="saveFolderBtn">Create Folder</button>
        </div>
      </div>
    </div>

    <script src="/JS/index.js"></script>
    <script src="/JS/auth.js"></script>
  </body>
</html>
